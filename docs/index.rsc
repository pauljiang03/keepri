13:["$","section",null,{"className":"research-section","id":"research","aria-labelledby":"research-title","children":["$","div",null,{"className":"shell research-layout","children":[["$","div",null,{"className":"research-intro","children":[["$","p",null,{"className":"section-kicker","children":"FOR AI RESEARCH & EVALUATION TEAMS"}],["$","h2",null,{"id":"research-title","children":["An answer is a moment.",["$","br",null,{}],["$","em",null,{"children":"Learning is a story."}]]}],["$","p",null,{"children":"How do people learn unfamiliar rules, recover from mistakes, and adapt when a rule changes? We’re building a way to study that process through carefully designed games."}],["$","a",null,{"className":"text-link","href":"mailto:pj1433@princeton.edu?subject=KeepRI%20research%20pilot","children":["Discuss a research pilot ",["$","$Ld",null,{"ref":"$undefined","iconNode":"$1:1:props:children:2:props:children:1:props:iconNode","className":"lucide-arrow-up-right","size":20,"aria-hidden":"true"}]]}],["$","span",null,{"className":"research-stage","children":"Seeking our first research partners"}]]}],["$","div",null,{"className":"research-deliverables","children":[["$","p",null,{"className":"deliverables-label","children":"THE PROGRAM WE’RE BUILDING"}],["$","article",null,{"className":"research-row","children":[["$","span",null,{"children":"01"}],["$","div",null,{"children":[["$","h3",null,{"children":"Executable environments"}],["$","p",null,{"children":"Game families with versioned rules, controlled variations, and reproducible scoring."}]]}]]}],["$","article",null,{"className":"research-row","children":[["$","span",null,{"children":"02"}],["$","div",null,{"children":[["$","h3",null,{"children":"Human learning histories"}],["$","p",null,{"children":"With separate permission: the actions, feedback, assistance, and outcomes that put a learning process in context."}]]}]]}],["$","article",null,{"className":"research-row","children":[["$","span",null,{"children":"03"}],["$","div",null,{"children":[["$","h3",null,{"children":"Evaluations with a human baseline"}],["$","p",null,{"children":"Scoped comparisons of learning, error recovery, and adaptation, built around your team’s research question."}]]}]]}],["$","div",null,{"className":"research-principle","children":[["$","strong",null,{"children":"Free to play. Free to choose."}],["$","p",null,{"children":"Our plan is for organizational research programs to support free games and meaningful rewards. Research participation will always require separate permission. No research enrollment or data-sale program is active in this beta."}]]}]]}]]}]}]
