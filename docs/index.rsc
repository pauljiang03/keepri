10:["$","div",null,{"className":"thesis-copy","data-reveal":true,"children":[["$","p",null,{"className":"lead","children":"As AI makes answers easier to obtain, we believe people will seek out places to exercise their own judgment."}],["$","p",null,{"children":"KeepRI gives that practice a home. Work through an unfamiliar problem without AI supplying the answer. Test an idea, learn from a mistake, and understand why your next move works."}],["$","p",null,{"children":"Games make the effort enjoyable. Competition, recognition, and prizes add reasons to keep going. Our mission is to make independent thinking something people choose to practice, improve at, and celebrate together."}]]}]
