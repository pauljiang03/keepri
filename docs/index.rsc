78:["$","section",null,{"className":"research-section shell","id":"research","aria-labelledby":"research-title","children":[["$","div",null,{"className":"research-heading","data-reveal":true,"children":[["$","p",null,{"className":"section-label","children":"The research opportunity"}],["$","h2",null,{"id":"research-title","children":["How we learn",["$","br",null,{}],"is part of the answer."]}],["$","p",null,{"children":"For AI teams, a final score leaves questions open. How was a strategy discovered? What happened after a mistake? What changed when the rules did?"}]]}],["$","div",null,{"className":"research-body","children":[["$","div",null,{"className":"research-question","data-reveal":true,"children":[["$","span",null,{"children":"A question we want to help answer"}],["$","p",null,{"children":"When a familiar rule changes, can an AI system adapt as effectively as a person?"}]]}],["$","div",null,{"className":"research-offer","data-reveal":true,"children":[["$","p",null,{"children":"We’re developing commissioned research programs that pair carefully designed environments with separately consented human learning histories."}],["$","div",null,{"className":"research-accordion","children":[["$","details",null,{"name":"research-deliverables","children":[["$","summary",null,{"children":["Executable environments"," ",["$","$L52",null,{"ref":"$undefined","iconNode":[["path",{"d":"M5 12h14","key":"1ays0h"}],["path",{"d":"M12 5v14","key":"s699le"}]],"className":"lucide-plus","size":20,"aria-hidden":"true"}]]}],["$","div",null,{"children":["$","p",null,{"children":"Versioned rules, controlled variants, scoring, and replay. A reproducible setting for studying how people and AI systems approach an unfamiliar problem."}]}]]}],["$","details",null,{"name":"research-deliverables","children":[["$","summary",null,{"children":["Human learning histories"," ",["$","$L52",null,{"ref":"$undefined","iconNode":"$78:props:children:1:props:children:1:props:children:1:props:children:0:props:ch